#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/hvnremotehub/hvnremotehub /usr/bin/hvnremotehub

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/hvnremotehub.service ]; then
			rm -f /etc/systemd/system/hvnremotehub.service /usr/lib/systemd/system/hvnremotehub.service /usr/lib/systemd/user/hvnremotehub.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/hvnremotehub/files/systemd/hvnremotehub.service /usr/lib/systemd/system/hvnremotehub.service
		# try fix error in Ubuntu 18.04
		# Failed to reload hvnremotehub.service: Unit hvnremotehub.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/hvnremotehub.service:10: Executable path is not absolute: pkill -f "rustdesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/hvnremotehub.service
		fi
		systemctl daemon-reload
		systemctl enable hvnremotehub
		systemctl start hvnremotehub
	fi
fi
